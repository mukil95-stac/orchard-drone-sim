      <site name="lidar_34" pos="0 0 .125" euler="-1.5707963 0 -5.9341195" size=".002"/>
      <site name="lidar_35" pos="0 0 .125" euler="-1.5707963 0 -6.1086524" size=".002"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="drive_fl" joint="wheel_fl_hinge" gear=".6"/>
    <motor name="drive_fr" joint="wheel_fr_hinge" gear=".6"/>
    <motor name="drive_rl" joint="wheel_rl_hinge" gear=".6"/>
    <motor name="drive_rr" joint="wheel_rr_hinge" gear=".6"/>
