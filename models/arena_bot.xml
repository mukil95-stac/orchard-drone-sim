<mujoco model="9x5_arena_bot">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual><global offwidth="1280" offheight="720"/><map znear=".01"/></visual>
  <default>
    <joint damping=".08" armature=".002"/>
    <geom friction="1.2 .01 .001" condim="3" rgba=".35 .38 .42 1"/>
    <motor ctrlrange="-12 12"/>
  </default>
  <worldbody>
    <light pos="0 0 5" dir="0 0 -1" diffuse=".8 .8 .8"/>
    <geom name="floor" type="plane" size="4.5 2.5 .1" rgba=".72 .74 .70 1"/>
    <geom name="north_wall" type="box" pos="0 2.53 .25" size="4.55 .03 .25" rgba=".15 .2 .25 1"/>
    <geom name="south_wall" type="box" pos="0 -2.53 .25" size="4.55 .03 .25" rgba=".15 .2 .25 1"/>
    <geom name="east_wall" type="box" pos="4.53 0 .25" size=".03 2.5 .25" rgba=".15 .2 .25 1"/>
    <geom name="west_wall" type="box" pos="-4.53 0 .25" size=".03 2.5 .25" rgba=".15 .2 .25 1"/>
    <body name="bot" pos="0 0 .135">
      <freejoint name="chassis_free"/>
      <inertial pos="0 0 0" mass="3" diaginertia=".0275 .0425 .065"/>
      <geom name="chassis" type="box" size=".20 .15 .075" mass="3" rgba=".12 .38 .72 1"/>
      <geom name="top_panel" type="box" pos="0 0 .077" size=".13 .105 .004" mass=".08" rgba=".08 .12 .18 1"/>
      <!-- Four driven 12 cm diameter wheels, with axle along local X. -->
      <body name="wheel_fl" pos="-.125 .12 -.075"><joint name="wheel_fl_hinge" type="hinge" axis="-1 0 0"/><geom name="wheel_fl_geom" type="cylinder" size=".06 .025" quat=".7071068 0 .7071068 0" mass=".22" rgba=".055 .06 .07 1"/></body>
      <body name="wheel_fr" pos=".125 .12 -.075"><joint name="wheel_fr_hinge" type="hinge" axis="-1 0 0"/><geom name="wheel_fr_geom" type="cylinder" size=".06 .025" quat=".7071068 0 .7071068 0" mass=".22" rgba=".055 .06 .07 1"/></body>
      <body name="wheel_rl" pos="-.125 -.12 -.075"><joint name="wheel_rl_hinge" type="hinge" axis="-1 0 0"/><geom name="wheel_rl_geom" type="cylinder" size=".06 .025" quat=".7071068 0 .7071068 0" mass=".22" rgba=".055 .06 .07 1"/></body>
      <body name="wheel_rr" pos=".125 -.12 -.075"><joint name="wheel_rr_hinge" type="hinge" axis="-1 0 0"/><geom name="wheel_rr_geom" type="cylinder" size=".06 .025" quat=".7071068 0 .7071068 0" mass=".22" rgba=".055 .06 .07 1"/></body>
      <!-- Heights are measured up from the chassis top (z = 7.5 cm). -->
      <camera name="front_webcam" pos="0 .04 .325" quat=".7071068 .7071068 0 0" fovy="75"/>
      <site name="imu_site" pos="0 0 .095" size=".008" rgba=".2 .9 .3 1"/>
      <site name="lidar_center" pos="0 0 .125" size=".008" rgba="1 .25 .1 1"/>
      <!-- 36 horizontal rangefinder beams, 10 degrees apart. -->
      <site name="lidar_00" pos="0 0 .125" euler="-1.5707963 0 0" size=".002"/>
      <site name="lidar_01" pos="0 0 .125" euler="-1.5707963 0 -.1745329" size=".002"/>
      <site name="lidar_02" pos="0 0 .125" euler="-1.5707963 0 -.3490659" size=".002"/>
